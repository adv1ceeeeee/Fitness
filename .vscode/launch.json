{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev (local .dart_define)",
      "request": "launch",
      "type": "dart",
      "args": ["--dart-define-from-file=.dart_define"]
    },
    {
      "name": "Production",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=.dart_define",
        "--dart-define=DART_DEFINE_PRODUCTION=true"
      ]
    }
  ]
}
