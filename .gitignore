# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Downloaded exercise images (uploaded to Supabase Storage, not needed in repo)
scripts/exercise_images/
scripts/exercisedb_mapping.csv

# Sentry native crash data
.sentry-native/

# Claude Code local settings
.claude/settings.local.json

# Release signing — keystore + passwords must never be committed
android/key.properties
android/app/*.jks
android/app/*.keystore

# Build outputs (tracked via .gitkeep placeholders only)
builds/**/*.apk
builds/**/*.aab
builds/**/*.ipa

# Personal local notes / credentials (never committed)
*.local.md
*.local.txt
*.local.json
